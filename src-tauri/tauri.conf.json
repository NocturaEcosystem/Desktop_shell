{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lepus",
  "version": "0.1.0",
  "identifier": "com.nonedude.Lepus",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "transparent": true,
        "decorations": false,
        "title": "Lepus",
        "resizable": false,
        "maximized": true,
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: app-icon: http://asset.localhost data:",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**/*",
          "/var/**",
          "**/.*/**",
          "/var/lib/flatpak/exports/share/icons/**",
          "/home/*/.local/share/icons/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
