{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for Lepus windows",
  "windows": [
    "background",
    "main",
    "middleground",
    "osd",
    "widgets"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:allow-open",
    "fs:read-all",
    "fs:write-all",
    {
      "identifier": "fs:scope",
      "allow": [
        "**/*",
        "/var/**",
        "**/.*/**"
      ]
    }
  ]
}