{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for Lepus windows",
  "windows": ["main", "osd", "middleground", "background"],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:allow-open",
    "fs:read-all",
    "fs:write-all",
    {
      "identifier": "fs:scope",
      "allow": [
        "**/*",
        "/var/**",
        "**/.*/**"
      ]
    }
  ]
}